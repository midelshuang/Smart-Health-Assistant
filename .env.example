# ============================================================
# HealthAI Platform - 环境变量配置模板
# 使用方法：复制为 .env 后填入实际值
#   cp .env.example .env
#   注意：.env 文件不要提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthai_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthai_db

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=please-change-this-secret-key-to-random-string
JWT_ALGORITHM=HS256

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=2.0

# ---------- LLM ----------
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ---------- Embedding ----------
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# ---------- ChromaDB ----------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---------- 应用配置 ----------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
